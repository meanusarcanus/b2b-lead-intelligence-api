{
  "openapi": "3.1.0",
  "info": {
    "title": "B2B Company & Decision-Maker Lead Intelligence Pro API",
    "description": "Real-time B2B firmographics, executive contact finder, verified business email extractor, and hiring signal intelligence for AI SDRs and sales automation.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/enrich-company": {
      "post": {
        "summary": "Enrich Company Endpoint",
        "description": "Enrich any company domain with firmographics, ARR estimate, headcount, and tech stack tags.",
        "operationId": "enrich_company_endpoint_api_v1_enrich_company_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanyEnrichRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Enrich Company Get",
        "description": "Quick GET endpoint for company firmographic enrichment.",
        "operationId": "enrich_company_get_api_v1_enrich_company_get",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Company domain",
              "examples": [
                "stripe.com"
              ],
              "title": "Domain"
            },
            "description": "Company domain"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/find-executives": {
      "post": {
        "summary": "Find Executives Endpoint",
        "description": "Discover key decision makers (Founders, C-Suite, VP Engineering, VP Sales) with verified emails.",
        "operationId": "find_executives_endpoint_api_v1_find_executives_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionMakerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hiring-signals": {
      "post": {
        "summary": "Hiring Signals Endpoint",
        "description": "Extract live hiring growth indicators and active job openings.",
        "operationId": "hiring_signals_endpoint_api_v1_hiring_signals_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HiringSignalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompanyEnrichRequest": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "Company domain name or website URL.",
            "example": "stripe.com"
          }
        },
        "type": "object",
        "required": [
          "domain"
        ],
        "title": "CompanyEnrichRequest"
      },
      "DecisionMakerRequest": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "Target company domain.",
            "example": "stripe.com"
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department",
            "description": "Filter by department: All, Executive, Engineering, Sales, Product.",
            "default": "All",
            "example": "Engineering"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit",
            "description": "Maximum number of leads to return.",
            "default": 5,
            "example": 5
          }
        },
        "type": "object",
        "required": [
          "domain"
        ],
        "title": "DecisionMakerRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HiringSignalRequest": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "Target company domain.",
            "example": "stripe.com"
          }
        },
        "type": "object",
        "required": [
          "domain"
        ],
        "title": "HiringSignalRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}